{
  "manifest_version": 3,
  "name": "Video Chat Broadcaster (WebRTC)",
  "version": "3.0.0",
  "description": "Transmits camera/mic via WebRTC using FileServer signaling.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Broadcast"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}